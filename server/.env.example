PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/appointment_db
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Nodemailer / SMTP Configuration
# For Gmail: Use a 16-character App Password generated from Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# OTP Security Parameters
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_SECRET=optional_dedicated_otp_hmac_secret_key

# Payment & Media Storage
STRIPE_SECRET_KEY=your_stripe_secret_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
